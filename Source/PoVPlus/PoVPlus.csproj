<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AssemblyName>PoVPlus</AssemblyName>
    <RootNamespace>PoVPlus</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableTomeDiagnostic Condition="'$(EnableTomeDiagnostic)' == ''">false</EnableTomeDiagnostic>
    <DefineConstants Condition="'$(EnableTomeDiagnostic)' == 'true'">$(DefineConstants);POVPLUS_TOME_DIAGNOSTIC</DefineConstants>
    <EnableTomeStageBDiagnostic Condition="'$(EnableTomeStageBDiagnostic)' == ''">false</EnableTomeStageBDiagnostic>
    <DefineConstants Condition="'$(EnableTomeStageBDiagnostic)' == 'true'">$(DefineConstants);POVPLUS_TOME_STAGE_B_DIAGNOSTIC</DefineConstants>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <ValheimDevPath Condition="'$(ValheimDevPath)' == ''">S:\Valheim-Modding\PoVPlus-Dev</ValheimDevPath>
  </PropertyGroup>

  <!-- All runtime dependencies stay in the game installation. -->
  <ItemGroup>
    <Compile Remove="Diagnostics\**\*.cs" />
    <Compile Include="Diagnostics\**\*.cs" Condition="'$(EnableTomeDiagnostic)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimDevPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimDevPath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimDevPath)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimDevPath)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimDevPath)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(EnableTomeStageBDiagnostic)' == 'true' and '$(EnableTomeDiagnostic)' != 'true'"
           Text="Stage B observation requires EnableTomeDiagnostic=true; it must never be included alone." />
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')"
           Text="Missing local reference: %(Reference.HintPath). Set ValheimDevPath to a compatible Valheim development installation." />
  </Target>
</Project>
