<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AssemblyName>PoVPlus</AssemblyName>
    <RootNamespace>PoVPlus</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <ValheimDevPath Condition="'$(ValheimDevPath)' == ''">S:\Valheim-Modding\PoVPlus-Dev</ValheimDevPath>
  </PropertyGroup>

  <!-- All runtime dependencies stay in the game installation. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimDevPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimDevPath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimDevPath)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimDevPath)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimDevPath)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')"
           Text="Missing local reference: %(Reference.HintPath). Set ValheimDevPath to a compatible Valheim development installation." />
  </Target>
</Project>
